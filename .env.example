# Docker 部署配置（复制为 .env；deploy/start.sh 会自动生成）
# 镜像名：默认 `artex-fork:local` 是本仓库本地构建的镜像。
# 想用现成镜像就改 ARTEX_IMAGE / ARTEX_TAG（必须是本 fork 发布的镜像，上游 ruoji6/artex 不含二开能力）
ARTEX_IMAGE=artex-fork
ARTEX_TAG=local
# 构建方式：Dockerfile.build=容器内编译（默认，宿主不用装 Go/Node）
#           Dockerfile=吃 scripts/package_linux.sh 产出的 dist/<arch>/artex（快，但要工具链）
ARTEX_DOCKERFILE=Dockerfile.build

ARTEX_PORT=8787
POSTGRES_USER=artex
# 必填；deploy/start.sh 首次运行会自动生成随机值。留空时 docker compose 会拒绝启动。
POSTGRES_PASSWORD=
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# ── P2~P5（凭据保险库 / 持有台账）────────────────────────────────
# 凭据加密密钥（32 字节 hex，或任意字符串由 SHA-256 派生）。
# 不填 → 每次启动生成一次性密钥：旧密文不可解（明文永不落库，这是兜底）。
# 生成：openssl rand -hex 32
ARTEX_CRED_KEY=

# ── 登录密码（deploy/start.sh 首次运行时自动生成并写在这里）─────────
ARTEX_PASSWORD=

# ── 资产测绘（可选组件 ScopeSentry）──────────────────────────────
# 0 = 只跑本体；1 = 同时跑测绘（deploy/enable-asm.sh 会置 1）
ASM_ENABLED=0
# 宿主端口；容器内始终是 8082（wire.sh 走容器网络，不依赖这个端口）
ASM_PORT=8082
# 默认只绑本机。要让另一台机器上的 ARTEX 连入，改成 0.0.0.0 并自行加防火墙。
ASM_BIND=127.0.0.1
# 上游：https://github.com/Autumn-27/ScopeSentry（web/mcp）
#       https://github.com/Autumn-27/ScopeSentry-Scan（扫描节点）
# 两个仓库发版不同步，必须分开锁：
#   ASM_TAG       = ScopeSentry 的版本（官方 release 的 semver，如 1.9.4）
#   ASM_SCAN_TAG  = 扫描节点镜像的 tag（扫描端通常落后；默认锁到 1.9.1）
# 升级：改 tag → bash deploy/start.sh（会重建/拉起容器；改源码才需要 --rebuild）
# 要完全可复现（tag 仍可能被上游重推）请用 image@sha256:<digest>；获取 digest：
#   docker buildx imagetools inspect autumn27/scopesentry:<tag>
#   docker buildx imagetools inspect autumn27/scopesentry-scan:<tag>
ASM_TAG=1.9.4
# 1.9.1 未核实镜像存在；若不存在，用本变量覆盖成已发布的固定版本（勿用 latest）。
ASM_SCAN_TAG=1.9.1
ASM_NODE_NAME=lab-node
ASM_MONGO_USER=root
ASM_MONGO_PASSWORD=
ASM_REDIS_PASSWORD=
# ScopeSentry 管理员（默认 ScopeSentry/ScopeSentry；改过密码要同步到这里，否则 wire 失败）
ASM_ADMIN_USER=ScopeSentry
ASM_ADMIN_PASSWORD=ScopeSentry
