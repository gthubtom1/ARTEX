# Docker 部署配置（复制为 .env；deploy/start.sh 会自动生成）
# 镜像名：默认 `artex-fork:local` 是本仓库本地构建的镜像。
# 想用现成镜像就改 ARTEX_IMAGE / ARTEX_TAG（必须是本 fork 发布的镜像，上游 ruoji6/artex 不含二开能力）
ARTEX_IMAGE=artex-fork
ARTEX_TAG=local
# 构建方式：Dockerfile.build=容器内编译（默认，宿主不用装 Go/Node）
#           Dockerfile=吃 scripts/package_linux.sh 产出的 dist/<arch>/artex（快，但要工具链）
ARTEX_DOCKERFILE=Dockerfile.build

ARTEX_PORT=8787
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# ── P2~P5（凭据保险库 / 持有台账）────────────────────────────────
# 凭据加密密钥（32 字节 hex，或任意字符串由 SHA-256 派生）。
# 不填 → 每次启动生成一次性密钥：旧密文不可解（明文永不落库，这是兜底）。
# 生成：openssl rand -hex 32
ARTEX_CRED_KEY=

# ── 登录密码（deploy/start.sh 首次运行时自动生成并写在这里）─────────
ARTEX_PASSWORD=

# ── 资产测绘（可选组件 ScopeSentry）──────────────────────────────
# 0 = 只跑本体；1 = 同时跑测绘（deploy/enable-asm.sh 会置 1）
ASM_ENABLED=0
ASM_PORT=8082
# 镜像 tag。上游是周更项目，锁定版本比 latest 稳；升级时改这里再 --rebuild
ASM_TAG=latest
ASM_NODE_NAME=lab-node
ASM_MONGO_USER=root
ASM_MONGO_PASSWORD=
ASM_REDIS_PASSWORD=
# ScopeSentry 管理员（默认 ScopeSentry/ScopeSentry；改过密码要同步到这里，否则 wire 失败）
ASM_ADMIN_USER=ScopeSentry
ASM_ADMIN_PASSWORD=ScopeSentry
