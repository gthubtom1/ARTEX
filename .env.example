# Docker 部署配置（复制为 .env）
# 本仓库发布的 Docker Hub 镜像地址；参见 README 的部署说明。
ARTEX_IMAGE=ruoji6/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# ── P2~P5（凭据保险库 / 持有台账）────────────────────────────────
# 凭据加密密钥（32 字节 hex，或任意字符串由 SHA-256 派生）。
# 不填 → 每次启动生成一次性密钥：旧密文不可解（明文永不落库，这是兜底）。
# 生成：openssl rand -hex 32
ARTEX_CRED_KEY=
